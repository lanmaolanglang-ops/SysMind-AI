{
  "openapi": "3.1.0",
  "info": {
    "title": "SysMind AI Local API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "runtime"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "backend_version": {
            "type": "string",
            "title": "Backend Version"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version"
          },
          "ready": {
            "type": "boolean",
            "title": "Ready"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "backend_version",
          "api_version",
          "ready"
        ],
        "title": "HealthResponse"
      }
    }
  }
}
